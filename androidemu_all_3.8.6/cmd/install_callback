    # ============================================================
    # 3.5.9 性能优化：CPU 调度器动态调整
    # 设置 governor 为 ondemand（动态调频），并限制最低频率为最大频率的 40%，
    # 确保轻载时 CPU 不会降频过低导致响应延迟，同时重载时自动升到最高频。
    # 仅在支持 cpufreq 的设备上生效；不支持则静默跳过。
    # ============================================================
    _cpu_governor_setup() {
        local _gov_file="/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
        local _max_file="/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq"
        [ -f "$_gov_file" ] || return 0
        [ -f "$_max_file" ] || return 0
        local _max_freq=$(cat "$_max_file" 2>/dev/null)
        [ -n "$_max_freq" ] || return 0
        # 最低频率 = 最大频率的 40%（保证四核性能下限）
        local _min_freq=$(( _max_freq * 40 / 100 ))
        for _cpu in /sys/devices/system/cpu/cpu[0-9]*; do
            [ -d "$_cpu/cpufreq" ] || continue
            echo "ondemand" > "$_cpu/cpufreq/scaling_governor" 2>/dev/null || true
            echo "$_min_freq" > "$_cpu/cpufreq/scaling_min_freq" 2>/dev/null || true
        done
        echo "  CPU governor: ondemand, min_freq: ${_min_freq} KHz (max: ${_max_freq} KHz)"
    }
    _cpu_governor_setup || true

