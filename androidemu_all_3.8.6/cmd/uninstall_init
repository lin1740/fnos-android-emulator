#!/bin/bash
# ============================================================
# uninstall_init - 卸载/升级前脚本
# 设计原则：
#   1. 任何情况下都不得返回非0退出码（飞牛会判定为"执行脚本出错"）
#   2. 所有输出重定向到日志，stdout必须干净
#   3. 升级流程只做compose同步，不做任何破坏性清理
#   4. 所有命令都有错误兜底
# ============================================================

# 关键：不使用set -e，任何命令失败都不能导致脚本退出
set +e

# 日志目录（优先用飞牛提供的变量，兜底用标准路径）
LOG_DIR="${TRIM_PKGVAR:-/var/apps/androidemu/var}"
mkdir -p "$LOG_DIR" 2>/dev/null

# 输出重定向到日志（用更安全的方式，避免exec失败导致脚本异常）
exec >>"$LOG_DIR/uninstall_init.log" 2>&1

echo "========================================"
echo "[$(date '+%F %T')] uninstall_init 开始执行"
echo "  TRIM_APP_STATUS=${TRIM_APP_STATUS:-<未设置>}"
echo "  TRIM_OLD_APPVER=${TRIM_OLD_APPVER:-<未设置>}"
echo "  TRIM_TEMP_UPGRADE_FOLDER=${TRIM_TEMP_UPGRADE_FOLDER:-<未设置>}"
echo "  TRIM_APPDEST=${TRIM_APPDEST:-<未设置>}"
echo "========================================"

# ============================================================
# 升级守卫：升级流程只同步compose文件，不做任何清理
# 飞牛升级时可能设置以下任一变量：
#   - TRIM_APP_STATUS=UPGRADE
#   - TRIM_OLD_APPVER（旧版本号）
#   - TRIM_TEMP_UPGRADE_FOLDER（临时升级目录）
#   - TRIM_APP_OP=upgrade（部分版本用这个）
# ============================================================
IS_UPGRADE=0
if [ "$TRIM_APP_STATUS" = "UPGRADE" ]; then IS_UPGRADE=1; fi
if [ -n "${TRIM_OLD_APPVER:-}" ]; then IS_UPGRADE=1; fi
if [ -n "${TRIM_TEMP_UPGRADE_FOLDER:-}" ]; then IS_UPGRADE=1; fi
if [ "${TRIM_APP_OP:-}" = "upgrade" ]; then IS_UPGRADE=1; fi

if [ "$IS_UPGRADE" = "1" ]; then
    echo "[$(date '+%F %T')] 检测到升级流程，仅同步compose文件，不做清理"
    mkdir -p /docker 2>/dev/null
    if [ -f "${TRIM_APPDEST}/docker/docker-compose.yaml" ]; then
        cp -f "${TRIM_APPDEST}/docker/docker-compose.yaml" /docker/docker-compose.yaml 2>/dev/null
        chmod 644 /docker/docker-compose.yaml 2>/dev/null
        echo "[$(date '+%F %T')] compose文件已同步到/docker/"
    else
        echo "[$(date '+%F %T')] 警告：未找到compose文件 ${TRIM_APPDEST}/docker/docker-compose.yaml"
    fi
    echo "[$(date '+%F %T')] 升级守卫完成，正常退出"
    exit 0
fi

echo "[$(date '+%F %T')] 非升级流程，执行完整卸载清理"

# ============================================================
# 1) 停止后台拉取进程
# ============================================================
VAR_DIR="${TRIM_PKGVAR:-/var/apps/androidemu/var}"
if [ -f "$VAR_DIR/pull.pid" ]; then
    PID=$(cat "$VAR_DIR/pull.pid" 2>/dev/null)
    if [ -n "$PID" ]; then
        kill "$PID" 2>/dev/null
        echo "[$(date '+%F %T')] 已停止拉取进程 PID=$PID"
    fi
fi
pkill -f "pull_image.sh" 2>/dev/null
pkill -f "start_pull_bg.sh" 2>/dev/null
rm -f "$VAR_DIR/pull.pid" "$VAR_DIR/pull.log" "$VAR_DIR/pull-progress.log" "$VAR_DIR/eta.state" 2>/dev/null

# ============================================================
# 2) 停止网关和音频守护
# ============================================================
if [ -f "${TRIM_APPDEST}/server/gateway.py" ]; then
    python3 "${TRIM_APPDEST}/server/gateway.py" stop 2>/dev/null
    echo "[$(date '+%F %T')] 已停止网关"
fi
if [ -f "${TRIM_APPDEST}/scripts/androidemu_daemon.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/androidemu_daemon.sh" stop 2>/dev/null
    echo "[$(date '+%F %T')] 已停止音频守护"
fi
rm -f "${TRIM_APPDEST}/app.sock" 2>/dev/null
rm -f "$VAR_DIR/gateway.lock" "$VAR_DIR/audio_fix.pid" 2>/dev/null

# ============================================================
# 3) 强制删除容器（不依赖compose，compose文件异常也能清干净）
# ============================================================
for C in androidemu-android androidemu-webrtc androidvm-rd-android androidvm-rd-webrtc; do
    docker rm -f "$C" 2>/dev/null
done
echo "[$(date '+%F %T')] 已清理容器"

# ============================================================
# 4) 删除网络
# ============================================================
docker network rm androidemu_default docker_default androidvm-rd_default 2>/dev/null
echo "[$(date '+%F %T')] 已清理网络"

# ============================================================
# 5) compose down 兜底
# ============================================================
if [ -d "${TRIM_APPDEST}/docker" ]; then
    cd "${TRIM_APPDEST}/docker" 2>/dev/null
    docker compose -p androidemu down -t 30 --remove-orphans 2>/dev/null
    echo "[$(date '+%F %T')] compose down 完成"
fi

# ============================================================
# 6) 镜像：默认保留，只有卸载向导明确选择删除才删
# ============================================================
if [ "${wizard_delete_images:-false}" = "true" ]; then
    echo "[$(date '+%F %T')] 用户选择删除镜像，开始清理"
    for IMG in         "redroid/redroid:11.0.0-latest"         "docker.fnnas.com/redroid/redroid:11.0.0-latest"         "docker.m.daocloud.io/redroid/redroid:11.0.0-latest"         "buutuu/scrcpy-over-webrtc:latest"         "docker.fnnas.com/buutuu/scrcpy-over-webrtc:latest"         "docker.m.daocloud.io/buutuu/scrcpy-over-webrtc:latest"         "androidemu-cache/redroid:12.0.0"         "androidemu-cache/webrtc:latest"; do
        docker image rm "$IMG" 2>/dev/null
    done
    docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -E '^((docker\.m\.daocloud\.io|docker\.fnnas\.com)/)?(redroid/redroid|buutuu/scrcpy-over-webrtc):' | sort -u | while read -r IMG; do
        docker image rm "$IMG" 2>/dev/null
    done
    echo "[$(date '+%F %T')] 镜像清理完成"
else
    echo "[$(date '+%F %T')] 保留容器镜像（未选择删除），下次安装可直接复用"
fi

echo "[$(date '+%F %T')] uninstall_init 完成，正常退出"
exit 0
