#!/bin/bash

### This script is called after the user upgrades the application.
### Re-apply the same safeguards as install_callback so that an upgrade
### from a previous version keeps images ready, PUBLIC_IP correct, and
### GPU passthrough / software-render fallback intact. x86 与 ARM 合包后，
### 本脚本同样按宿主架构自适应 DRI 路径、binderfs 与软件渲染回退。

### 关键：把本脚本全部输出重定向到日志文件，保证 stdout 干净。
### 飞牛对升级/安装脚本的 stdout 敏感：若脚本向标准输出打印内容
### （如镜像拉取 echo 日志），会被判定为「脚本出错且原因未知」。
LOG_DIR="${TRIM_PKGVAR:-/var/apps/androidemu/var}"
### 2.0.57 修复：本脚本此前只定义了 LOG_DIR，却在端口逻辑里用了 ${VAR_DIR}/ports.conf，
###        变量为空导致写入 /ports.conf 报 Permission denied —— 后果是安装/升级向导里的
###        「自定义端口」根本没生效（一直用默认端口）。补齐定义。
VAR_DIR="${TRIM_PKGVAR:-/var/apps/androidemu/var}"
mkdir -p "$LOG_DIR" 2>/dev/null || true
exec >> "$LOG_DIR/upgrade.log" 2>&1

### ============================================================
### 3.0.1：安装/升级中途取消或失败时的自动清理
### 防止残留容器/网络/临时文件占位，导致下次安装失败
### ============================================================
_INSTALL_SUCCESS=0
_cleanup_on_failure() {
    # 只有在未成功完成时才清理
    if [ "$_INSTALL_SUCCESS" = "1" ]; then
        return 0
    fi
    echo "[$(date '+%F %T')] 检测到安装/升级未正常完成，执行清理..." >&2

    # 1. 停止并删除本应用的容器（新旧命名都清）
    for _CN in androidemu-android androidemu-webrtc \
               androidemu_arm-android androidemu_arm-webrtc \
               androidvm-rd-android androidvm-rd-webrtc; do
        docker rm -f "$_CN" >/dev/null 2>&1 || true
    done

    # 2. 删除本应用的网络
    docker network rm androidemu_default androidvm-rd_default >/dev/null 2>&1 || true

    # 3. 停止后台进程（音频守护、agent部署、镜像拉取等，不碰网关）
    # 3.0.3：音频守护改用 Python 自带的 stop（PID 文件 + cmdline 身份校验），不再 pkill
    if [ -f "${TRIM_APPDEST}/scripts/androidemu_daemon.sh" ]; then
        bash "${TRIM_APPDEST}/scripts/androidemu_daemon.sh" stop >/dev/null 2>&1 || true
    fi
    pkill -f "bash .*androidemu.*/scripts/agent_autodeploy.sh" >/dev/null 2>&1 || true
    pkill -f "bash .*androidemu.*/scripts/start_pull_bg.sh" >/dev/null 2>&1 || true
    pkill -f "bash .*androidemu.*/scripts/pull_image.sh" >/dev/null 2>&1 || true
    pkill -f "bash .*androidemu.*/scripts/webrtc_watchdog.sh" >/dev/null 2>&1 || true
    pkill -f "bash .*androidemu.*/scripts/redroid_adb_forward.sh" >/dev/null 2>&1 || true
    # 注意：不停止网关服务、不删除 socket，由 systemd 自动管理

    # 5. 全新安装失败时，删除 /docker/docker-compose.yaml（如果是本应用创建的）
    #    升级时不删除，因为可能有其他版本依赖

    # 6. 删除临时状态文件
    rm -f "${TRIM_PKGVAR:-/var/apps/androidemu/var}/.installing" >/dev/null 2>&1 || true

    echo "[$(date '+%F %T')] 清理完成" >&2
}
trap _cleanup_on_failure EXIT INT TERM HUP
### ============================================================



echo "[$(date '+%F %T')] ==== upgrade_callback 开始，宿主架构：$(uname -m)，旧版本：${TRIM_OLD_APPVER:-未知} ===="

### 0) 升级前清理旧容器（保留数据卷 androidemu-data，安卓应用数据不丢），
###    避免旧容器状态异常或 recreate 冲突导致升级失败（飞牛报「执行脚本出错且原因未知」）。
###    兼容改名前的旧版残留（androidvm-rd-*）与旧独立 ARM 版容器（androidemu_arm-*，
###    合包后统一接管；其数据卷不迁移，由用户自行决定保留/删除）。
for LEGACY_NAME in androidemu_arm-android androidemu_arm-webrtc \
                   androidvm-rd-android androidvm-rd-webrtc; do
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^${LEGACY_NAME}$"; then
        docker rm -f "${LEGACY_NAME}" 2>/dev/null || true
    fi
done

COMPOSE="${TRIM_APPDEST}/docker/docker-compose.yaml"
HELPER="${TRIM_APPDEST}/scripts/pull_image.sh"

### Round pull: ensure both images are present.
if [ -f "$HELPER" ]; then
    . "$HELPER"
    ensure_redroid_image || true
    ensure_webrtc_image || true
fi

### 1) Fill the real NAS IP into the compose file.
NAS_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
[ -z "$NAS_IP" ] && NAS_IP="127.0.0.1"
if [ -f "$COMPOSE" ]; then
    sed -i "s/PUBLIC_IP=127\.0\.0\.1/PUBLIC_IP=${NAS_IP}/g" "$COMPOSE"
fi

### 2) 架构识别 + GPU 直通/软件渲染 + binderfs 自适应校准（与 install_callback 一致，
###    统一由 tune_compose.sh 处理，幂等）。
ARCH="$(uname -m 2>/dev/null)"
IS_ARM=0
case "$ARCH" in
    aarch64|arm*|armv*) IS_ARM=1 ;;
esac
DRI_DIR=""
for D in /usr/lib/x86_64-linux-gnu/dri /usr/lib/aarch64-linux-gnu/dri /usr/lib/arm-linux-gnueabihf/dri; do
    [ -d "$D" ] && DRI_DIR="$D" && break
done
GPU_MODE="software"
if [ "$IS_ARM" = "0" ] && [ -e /dev/dri ] && [ -n "$DRI_DIR" ]; then
    GPU_MODE="host"
fi

if [ -f "$COMPOSE" ] && [ -f "${TRIM_APPDEST}/scripts/tune_compose.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/tune_compose.sh" "$COMPOSE" || true
fi

### 3) 启动前放开宿主 DRM 节点权限（仅 GPU 直通模式；通配 card*/renderD*，
###    兼容 Intel/AMD/nvidia 与 ARM Mali 的节点编号）。redroid 无 /bin/sh，
###    须宿主侧 chmod；最小收敛：仅对实际存在的节点操作，软件渲染回退时跳过。
if [ "$GPU_MODE" = "host" ] && [ -e /dev/dri ]; then
    for DRM_NODE in /dev/dri/card* /dev/dri/renderD*; do
        [ -e "$DRM_NODE" ] && chmod 666 "$DRM_NODE" 2>/dev/null || true
    done
fi

### 3.5) 安装/刷新 DRM 设备放权 udev 规则（2.0.1）：确保升级后「NAS 重启 + 容器自启」
###      路径同样能完成 boot（无 /dev/dri 时脚本自身跳过）。
if [ -f "${TRIM_APPDEST}/scripts/gpu_udev_rules.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/gpu_udev_rules.sh" install >/dev/null 2>&1 || true
fi

### 3.6) 保留用户已选访问模式（2.0.2）：按 net.conf 重放 PUBLIC_IP/USE_TLS/对外端口，
###      避免升级把用户的外网/反代设置覆盖回默认；随后第 5 步统一启动容器。
### 2.0.34：端口设置（向导可选）。install 向导默认 default（用默认端口）、可选 custom；
### upgrade 向导默认 keep（保持现有端口）、可选 custom。
PORTS_CONF="${VAR_DIR}/ports.conf"
port_cur() { sed -n "s/^$1=//p" "$PORTS_CONF" 2>/dev/null | head -n1; }
PMODE="${wizard_port_mode:-default}"
PW="${wizard_web_port:-}"; PT="${wizard_turn_port:-}"; PA="${wizard_adb_port:-}"
if [ "$PMODE" = "custom" ]; then
    [ -n "$PW" ] || PW="$(port_cur WEB_PORT)"; [ -n "$PW" ] || PW=8443
    [ -n "$PT" ] || PT="$(port_cur TURN_PORT)"; [ -n "$PT" ] || PT=3478
    [ -n "$PA" ] || PA="$(port_cur ADB_PORT)"; [ -n "$PA" ] || PA=5556
    case "$PW" in ''|*[!0-9]*) PW=8443 ;; esac
    case "$PT" in ''|*[!0-9]*) PT=3478 ;; esac
    case "$PA" in ''|*[!0-9]*) PA=5556 ;; esac
    { echo "WEB_PORT=$PW"; echo "TURN_PORT=$PT"; echo "ADB_PORT=$PA"; echo "UPDATED=$(date '+%F %T')"; } > "$PORTS_CONF" 2>/dev/null || true
    echo "[$(date '+%F %T')] 端口按向导设置更新：画面=$PW TURN=$PT ADB=$PA"
else
    if [ ! -f "$PORTS_CONF" ]; then
        { echo "WEB_PORT=8443"; echo "TURN_PORT=3478"; echo "ADB_PORT=5556"; echo "UPDATED=$(date '+%F %T')"; } > "$PORTS_CONF" 2>/dev/null || true
        echo "[$(date '+%F %T')] 使用默认端口：画面=8443 TURN=3478 ADB=5556"
    else
        echo "[$(date '+%F %T')] 保持现有端口：画面=$(port_cur WEB_PORT) TURN=$(port_cur TURN_PORT) ADB=$(port_cur ADB_PORT)"
    fi
fi
if [ -f "${TRIM_APPDEST}/scripts/net_mode.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/net_mode.sh" --no-restart || true
fi

### 4) 把校准后的 compose 同步到 /docker（飞牛 docker-project 升级/启停读取该路径）。
if [ -f "$COMPOSE" ]; then
    mkdir -p /docker 2>/dev/null || true
    cp -f "$COMPOSE" /docker/docker-compose.yaml 2>/dev/null || true
    chmod 644 /docker/docker-compose.yaml 2>/dev/null || true
fi

### 4.7) 数据存储位置（2.0.53）：升级时若检测到既有安卓数据则保持命名卷不动；
###      全新路径才会切换到应用空间内的 bind 挂载（幂等）。
if [ -f "${TRIM_APPDEST}/scripts/data_location.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/data_location.sh" || true
fi

### 5) Start the compose project.
###    2.0.15：启动容器之前必须先给宿主 DRM 节点放权，否则容器内 surfaceflinger
###    打不开 GPU（"no suitable EGLConfig found" 崩溃循环 → Android 不 boot → adb offline）。
if [ -f "${TRIM_APPDEST}/scripts/gpu_release.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/gpu_release.sh" >/dev/null 2>&1 || true
fi
if [ -d "${TRIM_APPDEST}/docker" ]; then
    cd "${TRIM_APPDEST}/docker" || true
    # -p androidemu：固定 compose 项目名，避免与飞牛应用中心创建的项目名不一致
    # 导致「容器名已被占用」Conflict，升级/启动失败（报执行脚本出错）
    docker compose -p androidemu up -d 2>/dev/null || true
fi

### 2.0.45：确保 webrtc 容器存在（曾因 --remove-orphans 在 compose 被中途改写时被当孤儿删除）
if [ -f "${TRIM_APPDEST}/scripts/webrtc_watchdog.sh" ]; then
    echo "[$(date '+%F %T')] 画面服务自检（端口级）…"
    bash "${TRIM_APPDEST}/scripts/webrtc_watchdog.sh" ensure || true
fi
### 2.0.22：确保本应用只有「一个 RED 安卓容器 + 一个穿云投屏容器」
for _N in $(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^(androidemu|androidvm-rd|androidemu_arm)' | grep -v -E '^androidemu-(android|webrtc)$'); do
    docker rm -f "$_N" 2>/dev/null || true
    echo "[$(date '+%F %T')] 已清理重复/历史容器：$_N"
done
### 2.0.22：自动把云手机 Agent 部署进安卓容器
if [ -f "${TRIM_APPDEST}/scripts/agent_autodeploy.sh" ]; then
    nohup bash "${TRIM_APPDEST}/scripts/agent_autodeploy.sh" >/dev/null 2>&1 &
fi
### 2.0.45：穿云投屏守护
if [ -f "${TRIM_APPDEST}/scripts/webrtc_watchdog.sh" ]; then
    nohup bash "${TRIM_APPDEST}/scripts/webrtc_watchdog.sh" start >/dev/null 2>&1 &
fi

### 3.0.3：启动统一网关（Python 单进程 + 自带守护/自愈）。
### 幂等：已健康则不重启；并会清理上一版遗留的网关进程（含 2.x 的 gw_socket.sh+gw_relay.py）。
### 3.0.5：改走同名薄壳 gw_socket.sh（安装/升级回调环境里 Python Popen 会 EACCES，
### 薄壳用 bash 原生 nohup+setsid 兜底拉起）。
if [ -f "${TRIM_APPDEST}/scripts/gw_socket.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/gw_socket.sh" start
    echo "[$(date '+%F %T')] 已启动 Python 统一网关服务（用户级别，自带守护）"
fi


### 6) 启动后兜底自愈：宿主节点放权 + 若 surfaceflinger 处于崩溃循环则重建容器。
###    仅 GPU 直通模式。
if [ "$GPU_MODE" = "host" ] && [ -f "${TRIM_APPDEST}/scripts/fix_gpu_perms.sh" ]; then
    nohup bash "${TRIM_APPDEST}/scripts/fix_gpu_perms.sh" >/dev/null 2>&1 &
fi

### 6.5) 音频编码器注册修复（2.0.3）：注册镜像内已存在但未声明的 Opus 编码器
###      3.0.3：改为同步执行一次（纯 Python 改 XML），失败原因会写入 audio.status
if [ -f "${TRIM_APPDEST}/scripts/androidemu_daemon.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/androidemu_daemon.sh" fix || true
fi
### 2.0.8：ADB 端口宿主转发（保证局域网 IP 与 127.0.0.1 都能连 redroid）
if [ -f "${TRIM_APPDEST}/scripts/redroid_adb_forward.sh" ]; then
    nohup bash "${TRIM_APPDEST}/scripts/redroid_adb_forward.sh" install >/dev/null 2>&1 &
fi
### 3.0.0：Python 音频守护（周期性补回 Opus 编码器声明）
### 3.0.5：改走同名薄壳 audio_watchdog.sh（Python 起不来时用 bash nohup+setsid 兜底）
if [ -f "${TRIM_APPDEST}/scripts/audio_watchdog.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/audio_watchdog.sh" start || true
fi

### 3.0.1：标记升级成功，防止 trap 清理
_INSTALL_SUCCESS=1

exit 0
