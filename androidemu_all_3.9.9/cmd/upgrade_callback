### 3.9.9：把 var 下由 root 创建的日志交还包用户（升级回调同样以系统身份运行）。
###   本回调开头虽已全量归位，但升级收尾还有 root 步骤（fix_gpu_perms、网关启动、
###   gpu_release）会新建 系统属主日志；包用户守护再追加就 Permission denied
###   （实测 boot_guard 日志反复出现 gpu_fix.log: Permission denied）。
if [ "$(id -u)" = "0" ]; then
    _AE_RUNU="${TRIM_RUN_USERNAME:-docker-androidemu}"
    if id "$_AE_RUNU" >/dev/null 2>&1; then
        ### 3.9.9 复测修订：runtime_guard 的 status / stamp / 标记、ADB 转发的
        ### pid / log / py 一并交还，否则包用户看护覆写状态会持续 Permission denied。
        for _lf in "${_VAR_DIR_394}"/*.log "${_VAR_DIR_394}"/boot_diag.status \
                   "${_VAR_DIR_394}"/ports.conf "${_VAR_DIR_394}"/profile-level \
                   "${_VAR_DIR_394}"/guard-on "${_VAR_DIR_394}"/runtime_guard.status \
                   "${_VAR_DIR_394}"/runtime_guard.stamp "${_VAR_DIR_394}"/adb_forward.pid \
                   "${_VAR_DIR_394}"/adb_forward.log "${_VAR_DIR_394}"/adb_forward.py; do
            [ -f "$_lf" ] || continue
            [ "$(stat -c %U "$_lf" 2>/dev/null)" = "$_AE_RUNU" ] && continue
            chown "$_AE_RUNU":docker "$_lf" 2>/dev/null || chown "$_AE_RUNU" "$_lf" 2>/dev/null || true
        done
        [ -d "${_VAR_DIR_394}" ] && chown "$_AE_RUNU":docker "${_VAR_DIR_394}" 2>/dev/null || true
        ### 3.9.9：docker/.env 同样交给包用户（权限保持 600）。后台 start_pull_bg.sh
        ### 以包用户跑 compose，读不到 系统属主的 .env 会直接起不来容器
        ### （实测 `open .../docker/.env: permission denied`，三次重试全失败）。
        if [ -f "${TRIM_APPDEST}/docker/.env" ]; then
            chown "$_AE_RUNU":docker "${TRIM_APPDEST}/docker/.env" 2>/dev/null || true
        fi
        ### 3.9.9 复测修订：升级自旧包时可能残留 系统身份的 ADB 转发守护
        ### （降权看护杀不掉它），在 root 回调里精确清理并以包用户补起。
        _AE_SYS_SUP=0
        for _p in $(ps -eo user=,pid=,args= 2>/dev/null \
                    | awk '$1=="root" && /redroid_adb_forward\.sh supervise/ {print $2}'); do
            kill -9 "$_p" 2>/dev/null || true
            _AE_SYS_SUP=1
        done
        if [ "$_AE_SYS_SUP" = "1" ] && [ -x "${TRIM_APPDEST}/scripts/redroid_adb_forward.sh" ]; then
            if ! ps -eo args= 2>/dev/null | grep -F "redroid_adb_forward.sh supervise" \
                 | grep -v grep | grep -q .; then
                nohup runuser -u "$_AE_RUNU" -- env TRIM_PKGVAR="${_VAR_DIR_394}" \
                    bash "${TRIM_APPDEST}/scripts/redroid_adb_forward.sh" install >/dev/null 2>&1 &
            fi
        fi
    fi
fi

