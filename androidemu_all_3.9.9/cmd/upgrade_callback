        TRIM_RUN_USERNAME="${TRIM_RUN_USERNAME:-docker-androidemu}" \
        bash "${TRIM_APPDEST}/scripts/resolution_guard.sh" start \
        >>"$_RG_VAR/upgrade.log" 2>&1 || true
