### 3.9.2 修正：镜像没就绪时不要在这里 up —— 否则 compose 会同步去拉约 2GB 镜像，
### 把安装流程拖住十几分钟，中途失败还会在应用中心留下「启用过但失败」的残影。
### 交给 start_pull_bg.sh：它拉完镜像后自己 up 一次，用户看到的才是干净的「安装完成 → 稍候可用」。
_AE_RT_OK=1
if [ -f "${TRIM_APPDEST}/scripts/rtconf.sh" ]; then
    # shellcheck disable=SC1091
    . "${TRIM_APPDEST}/scripts/rtconf.sh"; rtconf_load
fi
for _IMG in "${CANON_REDROID:-}" "${CANON_WEBRTC:-}"; do
    [ -z "$_IMG" ] && continue
    if ! docker image inspect "$_IMG" >/dev/null 2>&1; then
        _AE_RT_OK=0
        continue
    fi
    ### 3.9.4 修复（2026-11-02 实测）：画面服务镜像必须与锁定 digest「内容一致」才算
    ### 就绪。卸载时选"保留镜像"会留下旧版 tag（0.4.1），此前只判断 tag 是否存在，
    ### 于是安装阶段直接用旧镜像建容器；后台明明拉到了正确镜像、tag 也被改对，但
    ### 容器已建好不会自动重建 —— 用户始终看到 0.4.1 + "发现新版本 v0.4.3"。
    ### 现改为内容不匹配即视为未就绪，跳过这里的 up，交给 start_pull_bg 拉取后
    ### 强制重建（见 start_pull_bg.sh 的 --force-recreate）。
    case "$_IMG" in
        *scrcpy-over-webrtc*)
            if [ -n "${WEBRTC_DIGEST:-}" ]; then
                if ! docker image inspect -f '{{range .RepoDigests}}{{println .}}{{end}}' "$_IMG" 2>/dev/null \
                        | grep -q "${WEBRTC_DIGEST#sha256:}"; then
                    echo "[$(date '+%F %T')] 画面服务镜像内容与锁定版本不一致（当前为旧版 tag），交由后台拉取后强制重建"
                    _AE_RT_OK=0
                fi
            fi
            ;;
    esac
done
if [ -f "${TRIM_APPDEST}/docker/docker-compose.yaml" ]; then
    if [ "$_AE_RT_OK" = "1" ]; then
        ( cd "${TRIM_APPDEST}/docker" && docker compose -p androidemu up -d ) >/dev/null 2>&1 || true
        ### 3.9.8：容器起来后立刻给「容器内」/dev/dri 放权（宿主设备节点不动）
        if [ -f "${TRIM_APPDEST}/scripts/gpu_release.sh" ]; then
            bash "${TRIM_APPDEST}/scripts/gpu_release.sh" --wait 30 >/dev/null 2>&1 || true
        fi
        ### 3.9.9：投屏可启动性（app_process 副本 + 最小能力 + bind mount）
        if [ -f "${TRIM_APPDEST}/scripts/app_process_caps.sh" ]; then
            bash "${TRIM_APPDEST}/scripts/app_process_caps.sh" --install || true
        fi
        ### 3.9.9：受限档运行期复核（脚本内部按档位自判，非该档直接退出）
        if [ -f "${TRIM_APPDEST}/scripts/runtime_guard.sh" ]; then
            TRIM_PKGVAR="${VAR_DIR}" bash "${TRIM_APPDEST}/scripts/runtime_guard.sh" >/dev/null 2>&1 || true
        fi
        ### 3.9.9：系统导航条修复（镜像 overlay 缺失 → 导航条异常巨大遮挡应用底部控件；
        ### 安卓未启动完成时脚本自动跳过，由 boot_guard 巡检兜底）
        if [ -f "${TRIM_APPDEST}/scripts/fix_navbar.sh" ]; then
            TRIM_PKGVAR="${VAR_DIR}" bash "${TRIM_APPDEST}/scripts/fix_navbar.sh" --install || true
        fi

        echo "[$(date '+%F %T')] 镜像已就绪，容器已拉起"
        ### 3.9.8：compose 遇到 container_name 冲突时会先建一个 <12位hex>_androidemu-* 临时容器，
        ### 重建不干净就留在 Created 状态。旧代码只在 up 之前清一遍，up 过程中新产生的没人管 ——
        ### 实测全新安装后就出现 2 个 Created 孤儿（用户/群友看到「多个同名前缀容器」，
        ### 极端情况还会抢 8443 与 agent 连接）。这里 up 之后立刻再清一遍。
        _orph_list="$(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^[0-9a-f]{12}_androidemu-' || true)"
        for _orph in $_orph_list; do
            docker rm -f "$_orph" >/dev/null 2>&1 \
                && echo "[$(date '+%F %T')] 清理 compose 临时容器：$_orph"
        done
    else
        echo "[$(date '+%F %T')] 镜像尚未就绪（首次安装需下载约 2GB），已跳过安装阶段的容器启动；"
        echo "[$(date '+%F %T')] 后台拉取完成后会自动拉起容器（进度见 ${VAR_DIR}/pull-progress.log）"
    fi
fi

if [ -f "${TRIM_APPDEST}/scripts/gw_socket.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/gw_socket.sh" start
    echo "[$(date '+%F %T')] 已启动统一网关服务（Go，用户级别，自带守护）"
fi

