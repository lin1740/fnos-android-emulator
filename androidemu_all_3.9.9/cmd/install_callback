# 解析"宽x高"格式并校验，返回 宽x高 或默认值
_parse_res() {
    local input="$1" def_w="$2" def_h="$3" min_w="$4" max_w="$5" min_h="$6" max_h="$7"
    local w h
    # 支持 x、×、X、* 作为分隔符
    w=$(echo "$input" | sed -E 's/[xX×*]/ /' | awk '{print $1}')
    h=$(echo "$input" | sed -E 's/[xX×*]/ /' | awk '{print $2}')
    case "$w" in ''|*[!0-9]*) w="$def_w" ;; esac
    case "$h" in ''|*[!0-9]*) h="$def_h" ;; esac
    [ "$w" -lt "$min_w" ] 2>/dev/null || [ "$w" -gt "$max_w" ] 2>/dev/null && w="$def_w"
    [ "$h" -lt "$min_h" ] 2>/dev/null || [ "$h" -gt "$max_h" ] 2>/dev/null && h="$def_h"
    # 3.9.9：宽高一律向下取整到 16 的倍数（H.264 宏块 16x16）。
    # 原因（实测 2026-11-09）：非 16 对齐的分辨率会让编码器按宏块补齐后再写
    # frame_cropping 裁剪。WASM 软解自己算裁剪所以正常，而浏览器硬解按未裁剪
    # 尺寸取 stride，画面出现彩色条带 / 文字重影（花屏）。
    #   504x1088  -> SPS: mbs=32(512px) + crop_right=4  -> 硬解花屏
    #   1080x2340 -> SPS: mbs=68(1088px) + crop_right=4/底部6 -> 硬解花屏
    #   576x1280  -> SPS: mbs=36(576px) + frame_cropping_flag=0 -> 正常
    w=$(( w / 16 * 16 )); h=$(( h / 16 * 16 ))
    [ "$w" -lt 16 ] && w=16
    [ "$h" -lt 16 ] && h=16
    echo "${w}x${h}"
}
# 3.9.7：统一按「逻辑宽度 360dp」折算密度（dp = px*160/dpi）。
# 720→320、1080→480、1200→533、1920→853（上限 640）。360dp 是 Android 手机的标准
# 基准宽度，元素大小接近主流手机，不会因为密度过高而显得字小。
_calc_dpi() {
    local w="${1:-1080}" d
    case "$w" in ''|*[!0-9]*) w=1080 ;; esac
    d=$(( w * 160 / 360 ))
    [ "$d" -lt 120 ] && d=120
    [ "$d" -gt 640 ] && d=640
    echo "$d"
}
