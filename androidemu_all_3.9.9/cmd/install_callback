#!/bin/bash

### 3.9.9-r2：飞牛安装回调的 PATH 常不含 /usr/sbin（runuser 所在目录），
### 缺它时本脚本里的降权后台任务会静默回退成 高权限常驻。只补缺失段。
case ":${PATH:-}:" in
    *:/usr/sbin:*) ;;
    *) export PATH="${PATH:-/usr/local/bin:/usr/bin:/bin}:/usr/sbin:/sbin" ;;
esac

### This script is called after the user installs the application.
### 安装不阻塞：不做同步镜像拉取，只做必要校准，然后在后台拉取镜像，
### 镜像就绪后自动启动容器（start_pull_bg.sh）。
### 好处：安装秒完成，不会因拉取约 2GB 镜像占用过高资源导致 NAS 网页断连。

### 0) 免责声明安装向导兜底校验：向导默认 disagree，用户必须主动选择 agree。
###    仅当明确为 disagree 时中止；变量为空（非向导的幂等重执行场景）不阻断。
    case "${wizard_agree_disclaimer:-}" in
        *agree*) : ;;
        "")      : ;;
        *)
            echo "[$(date '+%F %T')] 未勾选同意《免责声明》，安装中止。" >&2
            exit 1
            ;;
    esac

LOG_DIR="${TRIM_PKGVAR:-/var/apps/androidemu/var}"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/androidemu/var}"
mkdir -p "$LOG_DIR" 2>/dev/null || true
exec >> "$LOG_DIR/install.log" 2>&1

### 3.9.9-r2：安装开始时清理旧版本遗留的 ADB 转发 socat。
### 旧版在 PATH 缺 /usr/sbin 时会把 socat 起成 高权限常驻，卸载回调是包用户杀不掉，
### 5556 会被指向已销毁容器的旧进程长期占用。这里按实际端口精确清理一次；
### 若回调本身也是包用户，对历史高权限实例无效（日志如实记录），但源头已修：
### 新版转发进程一律以包用户启动，不会再产生这类残留。
_AE_SPORT="$(grep -m1 '^ADB_PORT=' "$VAR_DIR/ports.conf" 2>/dev/null | cut -d= -f2)"
case "$_AE_SPORT" in ''|*[!0-9]*) _AE_SPORT=5556 ;; esac
for _AE_SP in $(ps -eo pid,args 2>/dev/null | grep -F "socat TCP-LISTEN:${_AE_SPORT}," | grep -v grep | awk '{print $1}'); do
    if kill -9 "$_AE_SP" 2>/dev/null; then
        echo "[$(date '+%F %T')] 安装前清理遗留 ADB 转发 socat（pid=$_AE_SP 端口=$_AE_SPORT）"
    else
        echo "[$(date '+%F %T')] 遗留 ADB 转发 socat 非本用户进程（pid=$_AE_SP），回调无权清理"
    fi
done
echo "[$(date '+%F %T')] 安装回调身份：$(id -un 2>/dev/null) uid=$(id -u 2>/dev/null)"

### 3.9.3 修正：应用树在解包后的一小段窗口内权限尚未被应用中心托管到位。
### 实测全新安装（NAS 2026-10-31）：官方日志里 tune_compose 对 compose 的
### grep/sed 共 19 条 Permission denied（17:54:58→18:02:25 窗口内），身份伪装
### 挂载、GPU/DRI 校正、翻译层细节全部落空；同一安装的后段（18:02 之后）
### 权限又被应用中心归一化、其余步骤均正常。这里在回调最前先行归一化：
### 系统身份环境下把应用树及 var 顶层遗留的 系统属主物件全部纠回到
### docker-androidemu 名下，后续 tune_compose / apply_rebrand / harden_system 的
### 写入与幂等重放才能成立。非 系统身份下本块整体跳过，行为不变。
### 只动本应用自己的目录，不触碰任何宿主其它路径。
if [ "$(id -u)" = "0" ]; then
    _APP_TREE="${TRIM_APPDEST:-/vol1/@appcenter/androidemu}"
    chown -R docker-androidemu:docker "$_APP_TREE" 2>/dev/null || true
    find "$VAR_DIR" ! -user docker-androidemu -exec chown docker-androidemu:docker {} + 2>/dev/null || true
    echo "[$(date '+%F %T')] 应用树/var 属主归一化完成（3.9.3 权限修正）"
fi

### 3.9.9：向导选择的权限级别「尽早」落盘。
### 实测 2026-11-09 主 NAS（3.9.9 全新安装）：飞牛 docker-project 的 compose up 与看护
### 抢建容器，报 cannot remove container ... container is running，安装被判失败并中止，
### install_callback 没能执行到底 —— 结果是 profile-level、ports.conf 全缺，用户明明选了
### 受限档，运行期复核（runtime_guard.status）却从未启用。
### 把写级别提到回调入口：后续任何步骤失败，用户的选择都不会丢。
case "${wizard_profile_level:-}" in
    none|full|minimal)
        echo "$wizard_profile_level" > "$VAR_DIR/profile-level" 2>/dev/null || true
        echo "[$(date '+%F %T')] 权限级别已落盘：$wizard_profile_level"
        ;;
esac

_INSTALL_SUCCESS=0

_PRECHECK_FAIL=0
_precheck_warn() {
    echo "[$(date '+%F %T')] [预检查-警告] $1"
    echo "[警告] $1" >&2
}
_precheck_fail() {
    echo "[$(date '+%F %T')] [预检查-失败] $1"
    echo "============================================================" >&2
    echo "  安装中止：$1" >&2
    echo "============================================================" >&2
    echo "  详细日志：/var/apps/androidemu/var/install.log" >&2
    echo "  反馈：官网 www.lin1740.de5.net" >&2
    echo "============================================================" >&2
    _PRECHECK_FAIL=1
}

_ARCH=$(uname -m)
echo "[$(date '+%F %T')] 架构：$_ARCH"
case "$_ARCH" in
    x86_64|amd64)
        if [ ! -e "/dev/binder" ]; then
            _precheck_fail "X86 架构未检测到内核 binder 设备节点（/dev/binder）。请先在飞牛应用中心安装并启用依赖应用「binder_linux」（依赖未满足时应用中心会直接拦住安装），确认其状态正常后再重新安装本应用。"
        else
            echo "[$(date '+%F %T')] binder 驱动：已检测到 /dev/binder"
        fi
        ;;
    aarch64|arm64)
        echo "[$(date '+%F %T')] ARM 架构：使用容器内 binderfs，无需宿主 binder 驱动"
        ;;
    *)
        _precheck_warn "未知架构 $_ARCH，可能不兼容"
        ;;
esac

# 内存检查
_MEM_TOTAL_KB=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}')
if [ -n "$_MEM_TOTAL_KB" ]; then
    _MEM_TOTAL_MB=$((_MEM_TOTAL_KB / 1024))
    echo "[$(date '+%F %T')] 总内存：${_MEM_TOTAL_MB}MB"
    if [ "$_MEM_TOTAL_MB" -lt 1024 ]; then
        _precheck_fail "内存不足（${_MEM_TOTAL_MB}MB < 1GB），安卓容器无法启动。请升级内存或关闭其他占用内存的应用。"
    elif [ "$_MEM_TOTAL_MB" -lt 2048 ]; then
        _precheck_warn "内存偏低（${_MEM_TOTAL_MB}MB < 2GB），安卓容器可能卡顿或被 OOM 杀死。建议关闭其他应用后再试。"
    fi
else
    _precheck_warn "无法读取内存信息"
fi

# Docker检查
if ! command -v docker >/dev/null 2>&1; then
    _precheck_fail "未检测到 docker 命令，请确认飞牛 Docker 服务已安装并启动。"
elif ! docker info >/dev/null 2>&1; then
    _precheck_fail "Docker 服务未运行或无权限访问。请在飞牛应用中心确认 Docker 已启动。"
else
    echo "[$(date '+%F %T')] Docker：可用"
fi

# 磁盘空间检查（应用所在分区）
_APP_DIR="${TRIM_APPDEST:-/vol1/@appcenter/androidemu}"
_DISK_AVAIL_KB=$(df -k "$_APP_DIR" 2>/dev/null | tail -1 | awk '{print $4}')
if [ -n "$_DISK_AVAIL_KB" ]; then
    _DISK_AVAIL_MB=$((_DISK_AVAIL_KB / 1024))
    echo "[$(date '+%F %T')] 应用目录可用空间：${_DISK_AVAIL_MB}MB"
    if [ "$_DISK_AVAIL_MB" -lt 2048 ]; then
        _precheck_fail "磁盘空间不足（${_DISK_AVAIL_MB}MB < 2GB），无法拉取约 2GB 的安卓镜像。请清理磁盘空间。"
    fi
else
    _precheck_warn "无法读取磁盘空间信息"
fi

# GPU检测（仅警告，不阻断，无GPU自动软件渲染）
if [ -e "/dev/dri" ]; then
    echo "[$(date '+%F %T')] GPU：检测到 /dev/dri，将尝试硬件加速"
else
    _precheck_warn "未检测到 /dev/dri（无 GPU 或驱动未装），将使用软件渲染，性能较低。这是正常的，不影响使用。"
fi

# 【3.8.8】TUN 设备检测与自动创建（支持 VPN / 代理类应用，否则装代理会闪退）
if [ ! -e "/dev/net/tun" ]; then
    echo "[$(date '+%F %T')] TUN：未检测到 /dev/net/tun，尝试自动创建..."
    mkdir -p /dev/net 2>/dev/null || true
    modprobe tun 2>/dev/null || true
    if [ ! -e "/dev/net/tun" ]; then
        mknod /dev/net/tun c 10 200 2>/dev/null || true
        chmod 666 /dev/net/tun 2>/dev/null || true
    fi
    if [ -e "/dev/net/tun" ]; then
        echo "[$(date '+%F %T')] TUN：已成功创建 /dev/net/tun，VPN/代理应用可正常使用"
    else
        echo "[$(date '+%F %T')] TUN：警告：无法创建 /dev/net/tun，VPN/代理类应用可能闪退"
    fi
else
    echo "[$(date '+%F %T')] TUN：已检测到 /dev/net/tun，VPN/代理应用可正常使用"
fi

# 如果有阻断项，退出
if [ "$_PRECHECK_FAIL" = "1" ]; then
    echo "[$(date '+%F %T')] 预检查未通过，安装中止"
    exit 1
fi
echo "[$(date '+%F %T')] 预检查全部通过"

### 3.9.3：依赖应用「binder_linux」的状态在安装阶段读不到 —— appcenter-cli 权限是 700/系统账号，
### 安装脚本以应用包用户身份运行（实测执行报 Permission denied），无权查询、更无权替用户启用它。
### 实测飞牛在启用前会校验该依赖，被停用会直接拒绝启用本应用并只弹「compose或者container异常」，
### 因此这条改为写进安装向导注意事项 + 自检报告（用户一键启用），不在安装阶段做无效尝试。
if command -v appcenter-cli >/dev/null 2>&1; then
    _dep_st="$(appcenter-cli status binder_linux_driver 2>/dev/null | tr -d '\r\n')"
    if [ -n "$_dep_st" ]; then
        echo "[$(date '+%F %T')] 依赖应用 binder_linux_driver：$_dep_st"
        [ "$_dep_st" = "running" ] || echo "[$(date '+%F %T')] 提示：依赖应用未处于启用状态，请到应用中心启用它，否则本应用无法启用"
    else
        echo "[$(date '+%F %T')] 依赖应用 binder_linux_driver 状态不可读（appcenter-cli 仅系统账号可执行，属正常现象）"
        echo "[$(date '+%F %T')] 提示：请确认应用中心里 binder_linux 处于「启用」状态，否则启用本应用会失败"
    fi
fi

_cleanup_on_failure() {
    # 只有在未成功完成时才清理
    if [ "$_INSTALL_SUCCESS" = "1" ]; then
        return 0
    fi
    echo "[$(date '+%F %T')] 检测到安装/升级未正常完成，执行清理..." >&2

    # 1. 停止并删除本应用的容器（新旧命名都清）
    for _CN in androidemu-android androidemu-webrtc \
               androidemu_arm-android androidemu_arm-webrtc \
               androidvm-rd-android androidvm-rd-webrtc; do
        docker rm -f "$_CN" >/dev/null 2>&1 || true
    done

    # 2. 删除本应用的网络
    docker network rm androidemu_default androidvm-rd_default >/dev/null 2>&1 || true

    # 3. 停止后台进程（音频守护、agent部署、镜像拉取等，不碰网关）
    if [ -f "${TRIM_APPDEST}/scripts/androidemu_daemon.sh" ]; then
        bash "${TRIM_APPDEST}/scripts/androidemu_daemon.sh" stop >/dev/null 2>&1 || true
    fi
    pkill -f "bash .*androidemu.*/scripts/agent_autodeploy.sh" >/dev/null 2>&1 || true
    pkill -f "bash .*androidemu.*/scripts/start_pull_bg.sh" >/dev/null 2>&1 || true
    pkill -f "bash .*androidemu.*/scripts/pull_image.sh" >/dev/null 2>&1 || true
    pkill -f "bash .*androidemu.*/scripts/webrtc_watchdog.sh" >/dev/null 2>&1 || true
    pkill -f "bash .*androidemu.*/scripts/redroid_adb_forward.sh" >/dev/null 2>&1 || true
    # 注意：不停止网关服务、不删除 socket，由 systemd 自动管理

    # 5. 全新安装失败时，删除 /docker/docker-compose.yaml（如果是本应用创建的）
    #    升级时不删除，因为可能有其他版本依赖
    if [ -f /docker/docker-compose.yaml ]; then
        if grep -q "androidemu" /docker/docker-compose.yaml 2>/dev/null; then
            rm -f /docker/docker-compose.yaml >/dev/null 2>&1 || true
        fi
    fi

    # 6. 删除临时状态文件
    rm -f "${TRIM_PKGVAR:-/var/apps/androidemu/var}/.installing" >/dev/null 2>&1 || true

    echo "[$(date '+%F %T')] 清理完成" >&2
}
trap _cleanup_on_failure EXIT INT TERM HUP

echo "[$(date '+%F %T')] ==== install_callback 开始，宿主架构：$(uname -m)，向导内核选项：${wizard_kernel_status:-未提供} ===="

COMPOSE="${TRIM_APPDEST}/docker/docker-compose.yaml"

### 3.9.8：把 compose 同步到 /docker/docker-compose.yaml（飞牛 docker-project 升级/启停读取该路径）。
### 说明：/docker 由系统账号拥有（755），包用户通常写不进去；本函数已改为 best-effort，
### 写不进去就跳过（飞牛的 docker 项目记录用的是绝对路径，不依赖这份副本）。
_ae_compose_to_docker(){
    ### 仅做 best-effort 同步：包用户对 /docker（系统账号 755）没有写权限时直接跳过，
    ### 不再借 高权限容器写入。飞牛的 docker 项目记录里保存的是绝对路径
    ### （/usr/trim/etc/dockermgr.conf 的 projects[].folder = <应用目录>/docker），
    ### 不依赖 /docker 这份副本，功能上缺失它也不影响安装、升级、启停。
    [ -f "$1" ] || return 0
    cp -f "$1" /docker/docker-compose.yaml 2>/dev/null || return 0
    chmod 644 /docker/docker-compose.yaml 2>/dev/null || true
    return 0
}

### 3.9.8：优先复用「保留数据卸载」时挪进数据卷的 ARM 系统库集（约 100MB），
### 避免重装再下载 5~10 分钟；没有该缓存时走原有自动获取流程，行为不变。
_HKEEP="${TRIM_PKGVAR:-/var/apps/androidemu/var}/vol-data/.houdini_keep"
_HDEST="${TRIM_APPDEST}/translation/houdini"
if [ -d "$_HKEEP" ]; then
    ### 解包后通常已有一个空的 translation/houdini 目录，同样要复用。
    if [ ! -d "$_HDEST" ] || [ -z "$(ls -A "$_HDEST" 2>/dev/null)" ]; then
        rm -rf "$_HDEST" 2>/dev/null || true
        mkdir -p "$(dirname "$_HDEST")" 2>/dev/null || true
        if mv "$_HKEEP" "$_HDEST" 2>/dev/null; then
            echo "[$(date '+%F %T')] 复用保留的 ARM 系统库集，无需重新下载"
        fi
    fi
fi

### 1) 清理本应用遗留容器（新旧命名都清：androidemu-* 历代命名、旧独立 ARM 版
###    androidemu_arm-*、改名前的 androidvm-rd-*。避免端口冲突与残留）。
for LEGACY_NAME in androidemu-android androidemu-webrtc \
                   androidemu_arm-android androidemu_arm-webrtc \
                   androidvm-rd-android androidvm-rd-webrtc; do
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^${LEGACY_NAME}$"; then
        docker rm -f "${LEGACY_NAME}" 2>/dev/null || true
    fi
done
### 3.9.6：清理 compose 名字冲突产生的孤儿容器（形如 <12位hash>_androidemu-android）。
### 这些孤儿会抢 8443 端口和 agent 连接，导致服务端收不到设备注册（用户看到「没有设备」），
### 也会让后续 compose up 因端口/名字冲突失败（官方实测：容器列表出现 3 个同名前缀容器）。
docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^[0-9a-f]{12}_androidemu-' | while read -r _orph; do
    docker rm -f "$_orph" >/dev/null 2>&1 && echo "[$(date '+%F %T')] 清理孤儿容器：$_orph" >&2
done

### 1.5) 复制 compose 文件到 /docker/docker-compose.yaml——飞牛 docker-project 机制升级时
###     把相对路径 docker 解析为根目录 /docker/，必须在此处放真实 compose 文件，
###     否则升级时报 open /docker/docker-compose.yaml: no such file or directory。
###     用真实文件而非软链接，避免飞牛机制不跟随软链接。
_ae_compose_to_docker "$COMPOSE"

### 2) 填充真实 NAS 局域网 IP 到 compose（WebRTC 前端 PUBLIC_IP 参数）。
### 3.4.9 修复：hostname -I 可能返回 Docker 网桥地址（172.x/10.x），
### 必须优先选择 192.168.x.x 局域网 IP；用 ip route 获取出口 IP 更准确。
NAS_IP=""
for _ip in $(hostname -I 2>/dev/null); do
    case "$_ip" in
        192.168.*) NAS_IP="$_ip"; break ;;
        10.*)     [ -z "$NAS_IP" ] && NAS_IP="$_ip" ;;
        172.1[6-9].*|172.2[0-9].*|172.3[0-1].*) : ;;  # Docker 网桥，跳过
        *)        [ -z "$NAS_IP" ] && NAS_IP="$_ip" ;;
    esac
done
# 兜底：用 ip route 获取默认出口 IP
if [ -z "$NAS_IP" ] || [ "$NAS_IP" = "127.0.0.1" ]; then
    NAS_IP=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
fi
[ -z "$NAS_IP" ] && NAS_IP="127.0.0.1"
if [ -f "$COMPOSE" ]; then
    # 兼容两种格式：硬编码 127.0.0.1 和变量引用 ${ANDROIDEMU_HOST_IP:-127.0.0.1}
    sed -i "s/PUBLIC_IP=127\.0\.0\.1/PUBLIC_IP=${NAS_IP}/g" "$COMPOSE"
    sed -i "s#PUBLIC_IP=\${ANDROIDEMU_HOST_IP:-127\.0\.0\.1}#PUBLIC_IP=${NAS_IP}#g" "$COMPOSE"
    sed -i -E "s/PUBLIC_IP=[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/PUBLIC_IP=${NAS_IP}/g" "$COMPOSE"
    sed -i "s#\${ANDROIDEMU_HOST_IP:-127\.0\.0\.1}#${NAS_IP}#g" "$COMPOSE"
    sed -i -E "s/@[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:3478/@${NAS_IP}:3478/g" "$COMPOSE"
fi

### 2.5) 确保使用标准版镜像（防止升级时残留 gms 标签）
if [ -f "$COMPOSE" ]; then
    if [ -f "${TRIM_APPDEST}/scripts/rtconf.sh" ]; then
        # shellcheck disable=SC1091
        . "${TRIM_APPDEST}/scripts/rtconf.sh"
        rtconf_load
    fi
    _RT_TAG="${REDROID_TAG:-12.0.0-latest}"
    _RT_OFF="${OFF_REDROID:-redroid/redroid:12.0.0-latest}"
    sed -i -E "s#(redroid/redroid):[^[:space:]]*-gms#\1:${_RT_TAG}#g" "$COMPOSE"
    sed -i -E "s#whojk/redroid:[^[:space:]]*#${_RT_OFF}#g" "$COMPOSE"
    echo "[$(date '+%F %T')] 标准版安卓系统（${_RT_OFF}）"
fi

### 安卓系统版本选择（3.9.2 新增）：安装向导下拉选择 redroid 镜像版本（10~16，默认 12）
###      选择结果写入 VAR_DIR/android_version（升级保持）与 docker/runtime.conf
###      （单一可信源，tune_compose/pull_image/start 全部经 rtconf.sh 取值）。
### 3.9.4：不再提供安卓系统版本选择，固定 Android 12 —— 12 尚未打磨完善，
### 不应向用户暴露 10~16 等未验证版本（2026-11-01 决定）。向导已删除该步骤；
### 这里连同环境变量一起忽略，防止绕过向导传入其他版本号。
ANDROID_VER_WIZ="12"
echo "$ANDROID_VER_WIZ" > "${VAR_DIR}/android_version"
export ANDROIDEMU_ANDROID_VER="$ANDROID_VER_WIZ"
_RT_CONF="${TRIM_APPDEST}/docker/runtime.conf"
if [ -f "$_RT_CONF" ]; then
