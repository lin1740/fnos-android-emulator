    bash "${TRIM_APPDEST}/scripts/androidemu_daemon.sh" fix || true
fi
if [ -f "${TRIM_APPDEST}/scripts/audio_watchdog.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/audio_watchdog.sh" start
    echo "[$(date '+%F %T')] 已启动 Python 音频修复与守护"
fi

_INSTALL_SUCCESS=1

### 3.9.2：安装收尾自动生成一份自检报告，用户遇到「启用失败/打不开」时可直接发这份文件
if [ -f "${TRIM_APPDEST}/scripts/selfcheck.sh" ]; then
    bash "${TRIM_APPDEST}/scripts/selfcheck.sh" --quiet >/dev/null 2>&1 || true
    echo "[$(date '+%F %T')] 自检报告已生成：${VAR_DIR}/selfcheck.txt（启用失败时先看这份）"
fi
### 3.9.4：TURN 中继随机凭据。
###   上游默认值 cloudphone_user:cloudphone_secure_password 写在公开文档里，而 3478 端口对外
###   监听、/api/ice_servers 又直接回显这组凭据 —— 知道默认值就能白嫖本机 TURN 中继带宽。
###   首次安装生成 16 位随机口令写入 docker/.env（600 权限），compose 通过变量读取；
###   已存在则一律保留，避免升级后在线设备与浏览器缓存的 ICE 凭据失配导致外网画面连不上。
_ENVF="${TRIM_APPDEST}/docker/.env"
if [ ! -s "$_ENVF" ] || ! grep -q '^TURN_PASSWORD=' "$_ENVF" 2>/dev/null; then
    _TP=$(head -c 96 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'A-Za-z0-9' | cut -c1-16)
    [ -n "$_TP" ] || _TP="cloudphone_secure_password"
    ( umask 077; printf 'TURN_USER=cloudphone_user\nTURN_PASSWORD=%s\n' "$_TP" > "$_ENVF" ) 2>/dev/null || true
    chmod 600 "$_ENVF" 2>/dev/null || true
    echo "[$(date '+%F %T')] 已生成 TURN 中继随机凭据：docker/.env（600）"
fi
### 3.9.9：.env 属主交给包用户（权限保持 600）。
###   本回调以系统身份生成这个文件，而「镜像未就绪」时后台 start_pull_bg.sh 会以包用户
###   执行 compose up —— 600 的 系统属主让它读不到 .env，实测 compose 直接报
###   `open .../docker/.env: permission denied`，三次重试全部失败、容器起不来。
###   已存在的 .env（升级/重装）同样归位，避免同一路径复发。
if [ "$(id -u)" = "0" ] && id "${TRIM_RUN_USERNAME:-docker-androidemu}" >/dev/null 2>&1; then
    chown "${TRIM_RUN_USERNAME:-docker-androidemu}":docker "$_ENVF" 2>/dev/null || true
fi

### 3.9.4：老用户升级路径 —— 把运行时生成、写死了上游默认口令的 compose 就地迁移。
###   新装直接用变量化模板；但已装机的 compose 是安装时生成的，不会随包覆盖，
###   所以这里做一次字符串级替换：把 turn:cloudphone_user:cloudphone_secure_password@
###   换成随机口令，并补一行 TURN_PASSWORD（容器 entrypoint 靠它生成 coturn 账号，
###   不补会导致 ICE 凭据与 coturn 校验失配、跨 NAT 时画面连不上）。改完立即校验，失败回滚。
_CMP="${TRIM_APPDEST}/docker/docker-compose.yaml"
_TP_EFF=$(sed -n 's/^TURN_PASSWORD=//p' "$_ENVF" 2>/dev/null | head -1 | tr -d '\r\n ')
if [ -f "$_CMP" ] && [ -n "$_TP_EFF" ] && [ "$_TP_EFF" != "cloudphone_secure_password" ]; then
    if grep -q 'cloudphone_user:cloudphone_secure_password@' "$_CMP" 2>/dev/null; then
        cp -f "$_CMP" "$_CMP.bak-turn" 2>/dev/null || true
        sed -i "s#cloudphone_user:cloudphone_secure_password@#cloudphone_user:${_TP_EFF}@#g" "$_CMP" 2>/dev/null || true
        if ! grep -q '^[[:space:]]*- TURN_PASSWORD=' "$_CMP" 2>/dev/null; then
            sed -i "s#^\([[:space:]]*\)- ICE_SERVERS=#\1- TURN_PASSWORD=${_TP_EFF}\n\1- ICE_SERVERS=#" "$_CMP" 2>/dev/null || true
        fi
        if docker compose -f "$_CMP" config -q >/dev/null 2>&1; then
            echo "[$(date '+%F %T')] TURN 凭据已迁移为随机口令（原 compose 备份 .bak-turn）"
        else
            cp -f "$_CMP.bak-turn" "$_CMP" 2>/dev/null || true
            echo "[$(date '+%F %T')] TURN 凭据迁移后 compose 校验不通过，已回滚（保持原凭据）"
        fi
    fi
fi

### 3.9.4：修正历史遗留的 props 属主。
###   早期版本有以 系统身份生成过这些属性文件的记录（安装日志里出现过
###   "rm: cannot remove .../props/vendor/vendor_dlkm/etc/build.prop: Permission denied"）。
###   之后 apply_rebrand 以应用用户运行时既删不掉、也覆盖不了，整体替换会失败并留下嵌套目录。
###   本回调以系统身份运行，顺手把整个 props 树归位给应用用户，从根上避免这个问题。
if [ -d "${VAR_DIR}/props" ]; then
    chown -R docker-androidemu:AppUsers "${VAR_DIR}/props" 2>/dev/null || true
    chmod -R u+rwX "${VAR_DIR}/props" 2>/dev/null || true
fi

### 3.9.9：把 var 下由系统账号创建的日志交还包用户。
###   本回调开头已做过一次全量归位，但那是「解包残留」的归位；后续系统身份步骤
###   （compose up 之后的 gpu_release、自检）会**新建** 系统属主的日志文件。
###   实测全新安装后 gpu_fix.log 属主是系统账号，包用户的守护再追加就 Permission denied
###   （boot_guard 日志反复出现「gpu_fix.log: Permission denied」，放权成功却没留记录）。
###   这里在退出前再归位一次，只动 var 下的日志与状态文件，不碰其它目录。
if [ "$(id -u)" = "0" ]; then
    _AE_RUNU="${TRIM_RUN_USERNAME:-docker-androidemu}"
    if id "$_AE_RUNU" >/dev/null 2>&1; then
        ### 3.9.9 复测修订：runtime_guard 的 status / stamp / 标记、ADB 转发的
        ### pid / log / py 也要交还包用户。此前只交还 *.log 与几个状态文件，
        ### 实测 runtime_guard.status 与 runtime_guard.stamp 留在 0:0 644，
        ### 包用户看护每轮覆写都 Permission denied，状态永远停在首次复核。
        for _lf in "$VAR_DIR"/*.log "$VAR_DIR"/boot_diag.status "$VAR_DIR"/ports.conf \
                   "$VAR_DIR"/profile-level "$VAR_DIR"/guard-on \
                   "$VAR_DIR"/runtime_guard.status "$VAR_DIR"/runtime_guard.stamp \
                   "$VAR_DIR"/adb_forward.pid "$VAR_DIR"/adb_forward.log \
                   "$VAR_DIR"/adb_forward.py; do
            [ -f "$_lf" ] || continue
            [ "$(stat -c %U "$_lf" 2>/dev/null)" = "$_AE_RUNU" ] && continue
            chown "$_AE_RUNU":docker "$_lf" 2>/dev/null || chown "$_AE_RUNU" "$_lf" 2>/dev/null || true
        done
        [ -d "$VAR_DIR" ] && chown "$_AE_RUNU":docker "$VAR_DIR" 2>/dev/null || true
        ### 3.9.9 复测修订：清掉历史遗留的 系统身份 ADB 转发守护。
        ### 降权看护杀不掉高权限进程，两者会同时抢 5556；只在系统身份回调里精确清理
        ### 「本应用脚本 + 系统账号」的 supervise，不碰其它进程。
        _AE_SYS_SUP=0
        for _p in $(ps -eo user=,pid=,args= 2>/dev/null \
                    | awk '$1=="root" && /redroid_adb_forward\.sh supervise/ {print $2}'); do
            kill -9 "$_p" 2>/dev/null || true
            _AE_SYS_SUP=1
        done
        if [ "$_AE_SYS_SUP" = "1" ] && [ -x "${TRIM_APPDEST}/scripts/redroid_adb_forward.sh" ]; then
            if ! ps -eo args= 2>/dev/null | grep -F "redroid_adb_forward.sh supervise" \
                 | grep -v grep | grep -q .; then
                nohup runuser -u "$_AE_RUNU" -- env TRIM_PKGVAR="$VAR_DIR" \
                    bash "${TRIM_APPDEST}/scripts/redroid_adb_forward.sh" install >/dev/null 2>&1 &
            fi
        fi
    fi
fi

### 3.9.4：安装收尾清理历史遗留的重名/旧命名容器。
###   原代码位于本文件末尾的 exit 0 之后，属于死代码，自加入起就没执行过。
###   这里移到退出前执行：只删本应用命名规则下的旧容器（androidemu* / androidvm-rd* /
###   androidemu_arm*），当前正在使用的 androidemu-android 与 androidemu-webrtc 明确保留。
for _N in $(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^(androidemu|androidvm-rd|androidemu_arm)' | grep -v -E '^androidemu-(android|webrtc)$'); do
    docker rm -f "$_N" 2>/dev/null || true
    echo "[$(date '+%F %T')] 已清理重复/历史容器：$_N"
done

### 3.9.9：硬件视频编码（可选，默认开启）—— 这里只记录用户选择，不在此处执行。
### 原因：启用过程需要重启 media（约 10 秒），放在安装回调里会拉长安装耗时、
### 有触发飞牛安装超时的风险；改由 boot_guard 在系统就绪后一次性执行。
if [ "${wizard_hwenc:-yes}" = "no" ]; then
    rm -f "$VAR_DIR/hwenc.requested" 2>/dev/null || true
    echo "[$(date '+%F %T')] 未启用硬件视频编码（使用软件编码）"
else
    echo "yes" > "$VAR_DIR/hwenc.requested" 2>/dev/null || true
    [ "$(id -u)" = "0" ] && [ -n "${TRIM_RUN_USERNAME:-}" ] && chown "$TRIM_RUN_USERNAME" "$VAR_DIR/hwenc.requested" 2>/dev/null || true
    echo "[$(date '+%F %T')] 已记录硬件视频编码启用请求（由看护在系统就绪后执行）"
fi

### 3.9.9：安装收尾删除安装窗口标记（install_init 写入），让看护恢复巡检。
###   不删的话，看护会一直以为「安装进行中」而不去补建容器。
rm -f "$VAR_DIR/.upgrade_window" 2>/dev/null || true

exit 0
