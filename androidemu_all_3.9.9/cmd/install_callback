    echo "[$(date '+%F %T')] 容器初始分辨率（手机端）：${RW}x${RH} @${RD}dpi"
else
    echo "[$(date '+%F %T')] 警告：compose 文件不存在，分辨率设置未应用"
fi

# 生成动态切换脚本
SWITCH_SCRIPT="${TRIM_APPDEST}/scripts/switch_resolution.sh"
cat > "$SWITCH_SCRIPT" << 'SWITCH_EOF'
#!/bin/bash
# 安卓容器分辨率动态切换脚本
# 用法：bash switch_resolution.sh <pc|phone|tablet|宽x高>
# 切换即时生效，无需重启容器（通过 adb shell wm size）

RES_CONF="/var/apps/androidemu/var/resolution.conf"
[ -f "$RES_CONF" ] || RES_CONF="/var/apps/androidemu/var/resolution.conf"

# 读取配置
get_res() {
    local key="$1"
    grep "^${key}=" "$RES_CONF" 2>/dev/null | head -n1 | cut -d= -f2
}

TARGET=""
case "${1:-}" in
    pc|PC)         TARGET=$(get_res PC) ;;
    phone|PHONE)   TARGET=$(get_res PHONE) ;;
    tablet|TABLET) TARGET=$(get_res TABLET) ;;
    *x*|*X*)       TARGET="$1" ;;
    *)
        echo "用法：bash $0 <pc|phone|tablet|宽x高>"
        echo "示例：bash $0 phone"
        echo "      bash $0 1080x1920"
        echo ""
        echo "当前配置："
        echo "  PC:     $(get_res PC)"
        echo "  PHONE:  $(get_res PHONE)"
        echo "  TABLET: $(get_res TABLET)"
        exit 1
        ;;
esac

[ -z "$TARGET" ] && { echo "错误：未找到对应分辨率配置"; exit 1; }

# 宽高向下对齐到 16 的倍数（H.264 宏块 16x16）。
# 非 16 对齐时编码器会补齐宏块再写 frame_cropping 裁剪，浏览器硬解按未裁剪尺寸
# 取 stride，画面会花屏（彩色条带/文字重影）；WASM 软解自己算裁剪所以正常。
_TW=$(echo "$TARGET" | sed -E 's/[xX×*]/ /' | awk '{print $1}')
_TH=$(echo "$TARGET" | sed -E 's/[xX×*]/ /' | awk '{print $2}')
case "$_TW" in ''|*[!0-9]*) ;; *)
    case "$_TH" in ''|*[!0-9]*) ;; *)
        _AW=$(( _TW / 16 * 16 )); _AH=$(( _TH / 16 * 16 ))
        [ "$_AW" -lt 16 ] && _AW=16
        [ "$_AH" -lt 16 ] && _AH=16
        if [ "$_AW" != "$_TW" ] || [ "$_AH" != "$_TH" ]; then
            echo "提示：${_TW}x${_TH} 不是 16 的倍数，已向下对齐为 ${_AW}x${_AH}（避免硬件解码花屏）"
            TARGET="${_AW}x${_AH}"
        fi
        ;;
    esac
    ;;

# 通过 ADB 切换分辨率（容器内 adb 5555，宿主 socat 转发到 5556）
echo "正在切换分辨率为 ${TARGET} ..."
adb connect 127.0.0.1:5556 >/dev/null 2>&1
sleep 1
adb -s 127.0.0.1:5556 shell wm size "${TARGET}" 2>&1
RESULT=$?
adb disconnect 127.0.0.1:5556 >/dev/null 2>&1

if [ $RESULT -eq 0 ]; then
    echo "✓ 分辨率已切换为 ${TARGET}（即时生效）"
else
    echo "✗ 切换失败，请确认容器已启动且 ADB 可用"
    echo "  备用方法：docker exec androidemu-android wm size ${TARGET}"
fi
SWITCH_EOF
chmod +x "$SWITCH_SCRIPT" 2>/dev/null || true
echo "[$(date '+%F %T')] 分辨率切换脚本已生成：$SWITCH_SCRIPT"

### 3.9.9：分辨率 16 对齐护栏 —— 安装完成立刻跑一次。
### 作用：把「向导填写 / 前端动态切换 / compose 启动参数 / conf 残留」四条入口
### 统一收口到 16 的倍数，保证送出的 H.264 不带 frame_cropping（硬解不花屏）。
### 幂等，全部对齐时零改动；护栏自身 15 秒一轮常驻，boot_guard 每 60 秒兜底复查。
